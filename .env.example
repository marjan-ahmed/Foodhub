# Copy to .env and fill in per restaurant. Never commit the real one.
RESTAURANT_CONFIG=restaurants/demo.json

# Meta WhatsApp Cloud API (from the Meta developer dashboard)
# WA_PHONE_ID is the default sending number. When several numbers share one
# app instance, each reply goes out via whichever number received the message.
WA_TOKEN=
WA_PHONE_ID=
WA_VERIFY_TOKEN=foodhub123

# Meta App secret (dashboard -> App settings -> Basic -> App secret).
# Enables X-Hub-Signature-256 webhook verification. REQUIRED for a live number.
WA_APP_SECRET=

# Per-line quantity cap: orders above this go to human review (default 20).
MAX_QTY=20

# Set to 0 in production: disables /demo and /api/sim (owner impersonation).
DEMO_MODE=1

# Fallback if the restaurant config has no owner_phone
OWNER_PHONE=

# Optional: LLM fallback for messages the deterministic parser can't handle.
# Free tier option: https://aistudio.google.com (Get API key)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

PORT=8000
